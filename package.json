{
  "name": "master-thesis-seminar-slides",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "bundle": "esbuild src/presentation.ts --bundle --format=iife --target=es2020 --sourcemap --minify --loader:.glb=dataurl --outfile=dist/presentation.js",
    "build": "npm run typecheck && npm run bundle",
    "watch": "esbuild src/presentation.ts --bundle --format=iife --target=es2020 --sourcemap --minify --loader:.glb=dataurl --outfile=dist/presentation.js --watch"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.2"
  }
}
